<xml xmlns="https://developers.google.com/blockly/xml">
  <variables>
    <variable id="stake">stake</variable>
    <variable id="last_result">last_result</variable>
  </variables>
  <block type="on_strategy">
    <statement name="STRATEGY_STACK">
      <block type="variables_set">
        <field name="VAR" id="stake">stake</field>
        <value name="VALUE">
          <block type="math_number">
            <field name="NUM">1</field>
          </block>
        </value>
        <next>
          <block type="variables_set">
            <field name="VAR" id="last_result">last_result</field>
            <value name="VALUE">
              <block type="text">
                <field name="TEXT">win</field>
              </block>
            </value>
          </block>
        </next>
      </block>
    </statement>
  </block>

  <block type="on_tick">
    <statement name="TICK_STACK">
      <block type="if">
        <mutation elseif="1"></mutation>
        <value name="IF0">
          <block type="logic_compare">
            <field name="OP">GT</field>
            <value name="A">
              <block type="tick_analysis_digit"></block>
            </value>
            <value name="B">
              <block type="math_number">
                <field name="NUM">2</field>
              </block>
            </value>
          </block>
        </value>
        <statement name="DO0">
          <block type="if">
            <mutation elseif="1"></mutation>
            <value name="IF0">
              <block type="logic_compare">
                <field name="OP">EQ</field>
                <value name="A">
                  <block type="variables_get">
                    <field name="VAR" id="last_result">last_result</field>
                  </block>
                </value>
                <value name="B">
                  <block type="text">
                    <field name="TEXT">loss</field>
                  </block>
                </value>
              </block>
            </value>
            <statement name="DO0">
              <block type="variables_set">
                <field name="VAR" id="stake">stake</field>
                <value name="VALUE">
                  <block type="math_arithmetic">
                    <field name="OP">MULTIPLY</field>
                    <value name="A">
                      <block type="variables_get">
                        <field name="VAR" id="stake">stake</field>
                      </block>
                    </value>
                    <value name="B">
                      <block type="math_number">
                        <field name="NUM">5</field>
                      </block>
                    </value>
                  </block>
                </value>
              </block>
            </statement>
            <value name="IF1">
              <block type="logic_compare">
                <field name="OP">EQ</field>
                <value name="A">
                  <block type="variables_get">
                    <field name="VAR" id="last_result">last_result</field>
                  </block>
                </value>
                <value name="B">
                  <block type="text">
                    <field name="TEXT">win</field>
                  </block>
                </value>
              </block>
            </value>
            <statement name="DO1">
              <block type="variables_set">
                <field name="VAR" id="stake">stake</field>
                <value name="VALUE">
                  <block type="math_number">
                    <field name="NUM">1</field>
                  </block>
                </value>
              </block>
            </statement>
            <next>
              <block type="trade">
                <field name="TRADETYPE">DIGITOVER</field>
                <field name="ASSET">Volatility 25 Index</field>
                <value name="STAKE">
                  <block type="variables_get">
                    <field name="VAR" id="stake">stake</field>
                  </block>
                </value>
              </block>
            </next>
          </block>
        </statement>
      </block>
    </statement>
  </block>

  <block type="after_purchase">
    <statement name="AFTER_PURCHASE_STACK">
      <block type="variables_set">
        <field name="VAR" id="last_result">last_result</field>
        <value name="VALUE">
          <block type="purchase_info_result"></block>
        </value>
      </block>
    </statement>
  </block>
</xml>
