<xml xmlns="https://developers.google.com/blockly/xml" is_dbot="true" collection="false">

  <variables>

    <variable id="baseStake">baseStake</variable>

    <variable id="currentStake">currentStake</variable>

    <variable id="multiplier">multiplier</variable>

    <variable id="digitThreshold">digitThreshold</variable>

    <variable id="volIndex">volIndex</variable>

    <variable id="lastDigit">lastDigit</variable>

  </variables>



  <!-- Initialization: set variables -->

  <block type="trade_definition" deletable="false" x="20" y="20">

    <statement name="INITIALIZATION">

      <block type="variables_set">

        <field name="VAR" id="baseStake">baseStake</field>

        <value name="VALUE"><shadow type="math_number"><field name="NUM">1</field></shadow></value>

        <next>

          <block type="variables_set">

            <field name="VAR" id="currentStake">currentStake</field>

            <value name="VALUE"><shadow type="math_number"><field name="NUM">1</field></shadow></value>

            <next>

              <block type="variables_set">

                <field name="VAR" id="multiplier">multiplier</field>

                <value name="VALUE"><shadow type="math_number"><field name="NUM">6</field></shadow></value>

                <next>

                  <block type="variables_set">

                    <field name="VAR" id="digitThreshold">digitThreshold</field>

                    <value name="VALUE"><shadow type="math_number"><field name="NUM">2</field></shadow></value>

                    <next>

                      <block type="variables_set">

                        <field name="VAR" id="volIndex">volIndex</field>

                        <value name="VALUE"><shadow type="math_number"><field name="NUM">100</field></shadow></value>

                      </block>

                    </next>

                  </block>

                </next>

              </block>

            </next>

          </block>

        </next>

      </block>

    </statement>

  </block>



  <!-- On each tick -->

  <block type="deriv_tick_event" x="20" y="200">

    <statement name="DO">

      <block type="variables_set">

        <field name="VAR" id="lastDigit">lastDigit</field>

        <value name="VALUE">

          <block type="math_modulo">

            <value name="DIVIDEND">

              <block type="math_floor">

                <value name="VALUE">

                  <block type="math_arithmetic">

                    <field name="OP">MULTIPLY</field>

                    <value name="A"><block type="variables_get"><field name="VAR" id="tick_quote">tick_quote</field></block></value>

                    <value name="B"><block type="math_number"><field name="NUM">10</field></block></value>

                  </block>

                </value>

              </block>

            </value>

            <value name="DIVISOR"><block type="math_number"><field name="NUM">10</field></block></value>

          </block>

        </value>

        <next>

          <block type="controls_if">

            <value name="IF0">

              <block type="logic_compare">

                <field name="OP">GT</field>

                <value name="A"><block type="variables_get"><field name="VAR" id="lastDigit">lastDigit</field></block></value>

                <value name="B"><block type="variables_get"><field name="VAR" id="digitThreshold">digitThreshold</field></block></value>

              </block>

            </value>

            <statement name="DO0">

              <block type="purchase">

                <field name="PURCHASE_LIST">DIGITDIFFERENT</field>

                <value name="AMOUNT"><block type="variables_get"><field name="VAR" id="currentStake">currentStake</field></block></value>

                <value name="DURATION"><shadow type="math_number"><field name="NUM">1</field></shadow></value>

                <value name="SYMBOL"><shadow type="text"><field name="TEXT">R_100</field></shadow>

                  <block type="text_replace">

                    <field name="FIND">{{volIndex}}</field>

                    <field name="REPLACEMENT"><block type="variables_get"><field name="VAR" id="volIndex">volIndex</field></block></field>

                    <value name="TEXT"><shadow type="text"><field name="TEXT">R_{{volIndex}}</field></shadow></value>

                  </block>

                </value>

              </block>

            </statement>

          </block>

        </next>

      </block>

    </statement>

  </block>



  <!-- After each purchase -->

  <block type="after_purchase" x="20" y="400">

    <statement name="AFTERPURCHASE_STACK">

      <block type="controls_if">

        <value name="IF0">

          <block type="contract_check_result"><field name="CHECK_RESULT">win</field></block>

        </value>

        <statement name="DO0">

          <block type="variables_set">

            <field name="VAR" id="currentStake">currentStake</field>

            <value name="VALUE"><block type="variables_get"><field name="VAR" id="baseStake">baseStake</field></block></value>

          </block>

        </statement>

        <next>

          <block type="controls_if">

            <value name="IF0">

              <block type="logic_compare"><field name="OP">EQ</field>

                <value name="A"><block type="contract_check_result"><field name="CHECK_RESULT">loss</field></block></value>

                <value name="B"><block type="contract_check_result"><field name="CHECK_RESULT">loss</field></block></value>

              </block>

            </value>

            <statement name="DO0">

              <block type="variables_set">

                <field name="VAR" id="currentStake">currentStake</field>

                <value name="VALUE">

                  <block type="math_arithmetic">

                    <field name="OP">MULTIPLY</field>

                    <value name="A"><block type="variables_get"><field name="VAR" id="currentStake">currentStake</field></block></value>

                    <value name="B"><block type="variables_get"><field name="VAR" id="multiplier">multiplier</field></block></value>

                  </block>

                </value>

              </block>

            </statement>

          </block>

        </next>

      </block>

    </statement>

  </block>

</xml>
